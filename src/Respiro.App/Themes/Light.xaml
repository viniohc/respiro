<!-- Claro: mesma identidade com índigo #4F46E5 (cor do brilho do portfólio) como acento legível sobre branco. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Bg">#F5F5FB</Color>
    <Color x:Key="Color.Accent">#4F46E5</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="#F5F5FB"/>
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#ECECF6"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#EEEEF8"/>
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#E4E4F2"/>
    <SolidColorBrush x:Key="Brush.Chip" Color="#EBEBF5"/>
    <SolidColorBrush x:Key="Brush.Track" Color="#E3E3F0"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#E0E0EE"/>
    <SolidColorBrush x:Key="Brush.BorderInput" Color="#C4C5DA"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#8E90B0"/>

    <SolidColorBrush x:Key="Brush.Text" Color="#13142B"/>
    <SolidColorBrush x:Key="Brush.Muted" Color="#4A4C6E"/>
    <SolidColorBrush x:Key="Brush.Subtle" Color="#62648A"/>
    <SolidColorBrush x:Key="Brush.Disabled" Color="#9FA1BA"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="#4F46E5"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#4338CA"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#3730A3"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#ECEBFD"/>
    <SolidColorBrush x:Key="Brush.AccentBorder" Color="#C3C0F7"/>
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Selection" Color="#E0DEFC"/>

    <SolidColorBrush x:Key="Brush.Danger" Color="#B4232C"/>
    <SolidColorBrush x:Key="Brush.DangerHover" Color="#961C24"/>
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FCEDEE"/>
    <SolidColorBrush x:Key="Brush.DangerBorder" Color="#EDB8BC"/>
    <SolidColorBrush x:Key="Brush.OnDanger" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Brush.Warning" Color="#7D5200"/>
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#FBF2DE"/>
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="#E9D29D"/>
</ResourceDictionary>
