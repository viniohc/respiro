<!-- Escuro: adaptação do tema "twilight" do portfólio (índigo profundo + acento periwinkle). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Bg">#13142B</Color>
    <Color x:Key="Color.Accent">#8EA2FF</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="#13142B"/>
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#0E0F22"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#1B1C38"/>
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#262743"/>
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#2E2F4E"/>
    <SolidColorBrush x:Key="Brush.Chip" Color="#24253F"/>
    <SolidColorBrush x:Key="Brush.Track" Color="#2C2D4A"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#2A2B45"/>
    <SolidColorBrush x:Key="Brush.BorderInput" Color="#3E405A"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#5A5C7A"/>

    <SolidColorBrush x:Key="Brush.Text" Color="#E7E7F8"/>
    <SolidColorBrush x:Key="Brush.Muted" Color="#A3A5C8"/>
    <SolidColorBrush x:Key="Brush.Subtle" Color="#8B8DB2"/>
    <SolidColorBrush x:Key="Brush.Disabled" Color="#62647F"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="#8EA2FF"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#A9B8FF"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#7A8FF0"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#252949"/>
    <SolidColorBrush x:Key="Brush.AccentBorder" Color="#46508A"/>
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#0A0B1A"/>
    <SolidColorBrush x:Key="Brush.Selection" Color="#2B3060"/>

    <SolidColorBrush x:Key="Brush.Danger" Color="#E28F94"/>
    <SolidColorBrush x:Key="Brush.DangerHover" Color="#ECA9AD"/>
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#30253A"/>
    <SolidColorBrush x:Key="Brush.DangerBorder" Color="#624353"/>
    <SolidColorBrush x:Key="Brush.OnDanger" Color="#1A0E14"/>

    <SolidColorBrush x:Key="Brush.Warning" Color="#E7C27D"/>
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#302B36"/>
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="#5E5244"/>
</ResourceDictionary>
