<Window x:Class="Respiro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Respiro.App.Controls"
        Title="Respiro" Width="1280" Height="840" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Sans}" FontSize="14"
        Foreground="{DynamicResource Brush.Text}" Background="{DynamicResource Brush.Bg}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- Selo de proteção dos arquivos: protegido nunca aparece como seguro. -->
        <DataTemplate x:Key="ProtectionCell">
            <Border x:Name="B" Style="{StaticResource Badge}" Padding="7,1" ToolTip="Classificação heurística. Nenhuma classificação autoriza remoção.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="I" Style="{StaticResource Text.Icon}" FontSize="11" Margin="0,0,6,0" Text="&#xE9CE;"/>
                    <TextBlock Text="{Binding Protection}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Nature}" Value="Protegido">
                    <Setter TargetName="B" Property="Style" Value="{StaticResource Badge.Warning}"/>
                    <Setter TargetName="I" Property="Text" Value="&#xE72E;"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Nature}" Value="PotencialmenteRegeneravel">
                    <Setter TargetName="B" Property="Style" Value="{StaticResource Badge.Accent}"/>
                    <Setter TargetName="I" Property="Text" Value="&#xE72C;"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="DecisionCell">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding Decision}">
                <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,8,0" Text="&#xE72E;" Foreground="{DynamicResource Brush.Muted}"/>
                <TextBlock Text="{Binding Decision}"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="TextElement.FontWeight" Value="Bold"/>
            <Setter Property="TextElement.FontSize" Value="13"/>
        </Style>
        <Style x:Key="DriveItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═════════════ Sidebar ═════════════ -->
        <Border x:Name="Sidebar" Width="232" Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,20,12,16">
                <StackPanel DockPanel.Dock="Top" Margin="6,0,0,22">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="7" Background="#13142B" AutomationProperties.Name="Logo do Respiro">
                            <Viewbox Margin="0">
                                <Canvas Width="112" Height="112">
                                    <Canvas.RenderTransform><RotateTransform Angle="45" CenterX="56" CenterY="56"/></Canvas.RenderTransform>
                                    <Path Data="M71,30.02 A30,30 0 1 1 41,30.02" Stroke="#8EA2FF" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Ellipse Canvas.Left="51.5" Canvas.Top="22.5" Width="9" Height="9" Fill="#E7E7F8"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock x:Name="BrandName" Text="Respiro" FontFamily="{StaticResource Font.Display}" FontSize="19" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="BrandTagline" Text="Espaço para o seu PC respirar." Style="{StaticResource Text.Caption}" Margin="0,10,0,0"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" x:Name="SidebarFooter" Style="{StaticResource Callout}" Margin="0,12,0,0" Padding="12,10"
                        ToolTip="Análise e diagnóstico somente leitura. Remoção apenas manual, por adaptadores específicos e arquivos comprovados.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA18;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}"/>
                        <TextBlock x:Name="SidebarFooterText" Text="Somente leitura por padrão" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Navegação principal">
                        <TextBlock x:Name="NavGroup1" Text="ARMAZENAMENTO" Style="{StaticResource Text.Eyebrow}" Margin="8,0,0,6"/>
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Content="Visão geral" Tag="&#xE80F;" ToolTip="Visão geral (Ctrl+1)" IsChecked="True" Checked="NavChecked"/>
                        <RadioButton x:Name="NavAnalyze" Style="{StaticResource NavItem}" Content="Analisar" Tag="&#xE721;" ToolTip="Analisar arquivos e pastas (Ctrl+2)" Checked="NavChecked"/>
                        <RadioButton x:Name="NavCategories" Style="{StaticResource NavItem}" Content="Categorias" Tag="&#xEB05;" ToolTip="Categorias e extensões (Ctrl+3)" Checked="NavChecked"/>
                        <RadioButton x:Name="NavPreview" Style="{StaticResource NavItem}" Content="Simulação" Tag="&#xE890;" ToolTip="Prévia de simulação (Ctrl+4)" Checked="NavChecked"/>
                        <TextBlock x:Name="NavGroup2" Text="WINDOWS" Style="{StaticResource Text.Eyebrow}" Margin="8,18,0,6"/>
                        <RadioButton x:Name="NavMaintenance" Style="{StaticResource NavItem}" Content="Manutenção" Tag="&#xE90F;" ToolTip="Diagnóstico de manutenção do Windows (Ctrl+5)" Checked="NavChecked"/>
                        <RadioButton x:Name="NavOptimization" Style="{StaticResource NavItem}" Content="Otimização" Tag="&#xE713;" ToolTip="Inicialização, processos e revisão de aplicativos (Ctrl+0)" Checked="NavChecked"/>
                        <RadioButton x:Name="NavApps" Style="{StaticResource NavItem}" Content="Aplicativos" Tag="&#xE71D;" ToolTip="Aplicativos instalados (Ctrl+6)" Checked="NavChecked"/>
                        <RadioButton x:Name="NavCleanup" Style="{StaticResource NavItem}" Content="Limpeza" Tag="&#xE74D;" ToolTip="Limpeza manual restrita (Ctrl+7)" Checked="NavChecked"/>
                        <TextBlock x:Name="NavGroup3" Text="REGISTRO" Style="{StaticResource Text.Eyebrow}" Margin="8,18,0,6"/>
                        <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" Content="Histórico" Tag="&#xE81C;" ToolTip="Histórico local (Ctrl+8)" Checked="NavChecked"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Content="Configurações" Tag="&#xE713;" ToolTip="Configurações (Ctrl+9)" Checked="NavChecked"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═════════════ Conteúdo ═════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barra de operação: visível em qualquer página enquanto algo roda. -->
            <Border x:Name="OperationPanel" Visibility="Collapsed" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="28,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock x:Name="OperationPercent" DockPanel.Dock="Right" Style="{StaticResource Text.Muted}" Margin="12,0,0,0"/>
                        <TextBlock x:Name="OperationTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
                    </DockPanel>
                    <ProgressBar x:Name="ScanBar" Grid.Row="1" Style="{StaticResource Meter}" Height="6" Margin="0,8,0,6" Maximum="100" AutomationProperties.Name="Progresso da operação"/>
                    <DockPanel Grid.Row="2">
                        <TextBlock x:Name="OperationDetail" DockPanel.Dock="Left" Style="{StaticResource Text.Caption}" Margin="0,0,12,0"/>
                        <TextBlock x:Name="OperationPath" Style="{StaticResource Text.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <Button x:Name="OperationCancel" Grid.Column="1" Grid.RowSpan="3" Margin="20,0,0,0" VerticalAlignment="Center" Click="Cancel" ToolTip="Interrompe a operação. Resultados parciais são preservados. (Esc)">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" Style="{StaticResource Text.Icon}" Margin="0,0,8,0"/><TextBlock Text="Cancelar"/></StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid x:Name="Pages" Grid.Row="1" Margin="32,24,32,16">

                <!-- ───────────── Visão geral ───────────── -->
                <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-16,0" Padding="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="ARMAZENAMENTO" Style="{StaticResource Text.Eyebrow}"/>
                        <WrapPanel>
                            <TextBlock Text="Visão geral" Style="{StaticResource Text.PageTitle}" Margin="0,0,14,0"/>
                            <Border Style="{StaticResource Badge.Accent}"><TextBlock Text="DIAGNÓSTICO · somente leitura"/></Border>
                        </WrapPanel>
                        <TextBlock Text="Espaço dos discos, resultado da última análise e o que o Respiro pode ou não fazer." Style="{StaticResource Text.Subtitle}"/>




                        <Grid x:Name="HomeTop" Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="HomeDiskCard" Style="{StaticResource Card}" Padding="24">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="168" Height="168" VerticalAlignment="Top">
                                        <c:UsageRing x:Name="HomeRing" Thickness="14" TrackBrush="{DynamicResource Brush.Track}" FillBrush="{DynamicResource Brush.Accent}"/>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock x:Name="HomeRingPercent" Text="—" FontFamily="{StaticResource Font.Display}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="ocupado" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="28,0,0,0">
                                        <TextBlock x:Name="HomeDriveName" Text="Disco" Style="{StaticResource Text.CardTitle}" FontSize="18"/>
                                        <TextBlock x:Name="HomeDriveLabel" Style="{StaticResource Text.Caption}" Margin="0,2,0,16"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Total" Style="{StaticResource Text.MetricLabel}"/>
                                                <TextBlock x:Name="HomeTotal" Text="—" Style="{StaticResource Text.Metric}" FontSize="20"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Usado" Style="{StaticResource Text.MetricLabel}"/>
                                                <TextBlock x:Name="HomeUsed" Text="—" Style="{StaticResource Text.Metric}" FontSize="20"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Disponível" Style="{StaticResource Text.MetricLabel}"/>
                                                <TextBlock x:Name="HomeFree" Text="—" Style="{StaticResource Text.Metric}" FontSize="20" Foreground="{DynamicResource Brush.Accent}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border x:Name="HomeFreeWarning" Style="{StaticResource Badge.Warning}" Margin="0,14,0,0" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="HomeFreeWarningText"/>
                                            </StackPanel>
                                        </Border>
                                        <WrapPanel Margin="0,18,0,0">
                                            <Button x:Name="HomeAnalyzeButton" Style="{StaticResource Button.Primary}" Click="HomeAnalyze" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" Margin="0,0,8,0"/><TextBlock x:Name="HomeAnalyzeText" Text="Analisar este disco"/></StackPanel>
                                            </Button>
                                            <Button Click="HomeChooseFolder" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Text.Icon}" Margin="0,0,8,0"/><TextBlock Text="Escolher pasta…"/></StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border x:Name="HomeDrivesCard" Grid.Column="2" Style="{StaticResource Card}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Discos" Style="{StaticResource Text.CardTitle}"/>
                                    <TextBlock DockPanel.Dock="Top" Text="Selecione para ver detalhes e analisar." Style="{StaticResource Text.Caption}" Margin="0,2,0,14"/>
                                    <ListBox x:Name="DriveList" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource DriveItem}"
                                             SelectionChanged="DriveListChanged" AutomationProperties.Name="Discos disponíveis"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding UsedPercentText}" Style="{StaticResource Text.Caption}"/>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text}"/>
                                                    </DockPanel>
                                                    <ProgressBar Style="{StaticResource Meter}" Height="6" Margin="0,8,0,6" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}"/>
                                                    <TextBlock Text="{Binding FreeText}" Style="{StaticResource Text.Caption}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Click="GoQuickCleanup" Content="Limpeza rápida" Style="{StaticResource Button.Primary}" Margin="12,0,0,0"/>
                                <StackPanel>
                                    <TextBlock Text="O que posso limpar?" Style="{StaticResource Text.CardTitle}"/>
                                    <TextBlock x:Name="HomeQuickSummary" Style="{StaticResource Text.Body}" Text="Ainda não analisado. Veja temporários, miniaturas e relatórios de falhas; revise o que precisa do Windows."/>
                                    <TextBlock x:Name="HomeSpaceTimeline" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" Text="Por que o espaço está acabando? Analise uma pasta ou disco para registrar espaço livre e comparar próximas análises."/>

                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <WrapPanel DockPanel.Dock="Right">
                                        <Button Style="{StaticResource Button.Ghost}" Click="GoAnalyze" Content="Ver arquivos"/>
                                        <Button Style="{StaticResource Button.Ghost}" Click="GoCategories" Content="Ver categorias"/>
                                    </WrapPanel>
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock Text="Última análise" Style="{StaticResource Text.CardTitle}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <Border x:Name="HomeScanStateBadge" Style="{StaticResource Badge}"><TextBlock x:Name="HomeScanState" Text="Nenhuma nesta sessão"/></Border>
                                    </WrapPanel>
                                </DockPanel>
                                <TextBlock x:Name="HomeScanRoot" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                <StackPanel x:Name="LastScanEmpty" Margin="0,14,0,0">
                                    <TextBlock Style="{StaticResource Text.Muted}" Text="Analise um disco ou pasta para ver quantidade de arquivos, tamanho lógico, espaço ocupado e as categorias que mais pesam. A análise apenas lê metadados; nada é alterado."/>
                                </StackPanel>
                                <StackPanel x:Name="LastScanPanel" Visibility="Collapsed" Margin="0,18,0,0">
                                    <UniformGrid x:Name="HomeMetrics" Columns="3">
                                        <StackPanel Margin="0,0,16,16"><TextBlock Text="Arquivos" Style="{StaticResource Text.MetricLabel}"/><TextBlock x:Name="HomeFiles" Style="{StaticResource Text.Metric}"/></StackPanel>
                                        <StackPanel Margin="0,0,16,16"><TextBlock Text="Pastas" Style="{StaticResource Text.MetricLabel}"/><TextBlock x:Name="HomeFolders" Style="{StaticResource Text.Metric}"/></StackPanel>
                                        <StackPanel Margin="0,0,16,16"><TextBlock Text="Tamanho lógico" Style="{StaticResource Text.MetricLabel}" ToolTip="Soma dos comprimentos, descontando hard links reconhecidos."/><TextBlock x:Name="HomeLogical" Style="{StaticResource Text.Metric}"/></StackPanel>
                                        <StackPanel Margin="0,0,16,16"><TextBlock Text="Ocupado conhecido" Style="{StaticResource Text.MetricLabel}" ToolTip="Alocação retornada pelo Windows. Não equivale a espaço recuperável."/><TextBlock x:Name="HomeOccupied" Style="{StaticResource Text.Metric}"/></StackPanel>
                                        <StackPanel Margin="0,0,16,16"><TextBlock Text="Ocorrências" Style="{StaticResource Text.MetricLabel}" ToolTip="Pastas ou arquivos inacessíveis durante a análise."/><TextBlock x:Name="HomeIssues" Style="{StaticResource Text.Metric}"/></StackPanel>
                                        <StackPanel Margin="0,0,16,16"><TextBlock Text="Ocupações inconclusivas" Style="{StaticResource Text.MetricLabel}"/><TextBlock x:Name="HomeUnknown" Style="{StaticResource Text.Metric}"/></StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="CATEGORIAS QUE MAIS OCUPAM" Style="{StaticResource Text.Eyebrow}" Margin="0,6,0,10"/>
                                    <StackPanel x:Name="HomeTopCategories"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Como o Respiro trabalha" Style="{StaticResource Text.CardTitle}"/>
                                <TextBlock Text="Três modos com regras diferentes. O selo no topo de cada tela indica qual está em uso." Style="{StaticResource Text.Caption}" Margin="0,2,0,16"/>
                                <UniformGrid x:Name="HomeModes" Columns="3">
                                    <StackPanel Margin="0,0,20,12">
                                        <Border Style="{StaticResource Badge.Accent}"><TextBlock Text="DIAGNÓSTICO"/></Border>
                                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,10,0,0" Text="Lê metadados de arquivos e consultas oficiais do Windows. Não altera arquivos nem configurações."/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,20,12">
                                        <Border Style="{StaticResource Badge.Warning}"><TextBlock Text="SIMULAÇÃO"/></Border>
                                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,10,0,0" Text="Verifica uso, integridade e contexto Git da seleção. Nada é removido; a prévia geral autoriza 0 B."/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,20,12">
                                        <Border Style="{StaticResource Badge.Danger}"><TextBlock Text="LIMPEZA REAL"/></Border>
                                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,10,0,0" Text="Somente categorias e arquivos comprovados, com seleção manual, prévia e confirmações. Remoção permanente; arquivos pessoais exigem revisão no Explorador."/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Click="GoMaintenance" Margin="16,0,0,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" Style="{StaticResource Text.Icon}" Margin="0,0,8,0"/><TextBlock Text="Abrir manutenção"/></StackPanel>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="Manutenção do Windows" Style="{StaticResource Text.CardTitle}"/>
                                    <TextBlock x:Name="HomeWindowsSummary" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" Text="Diagnóstico ainda não executado nesta sessão. Mede temporários, caches, hibernação, paginação, restauração e aplicativos instalados."/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ───────────── Analisar ───────────── -->
                <Grid x:Name="PageAnalyze" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="AnalyzeHeader">
                        <TextBlock Text="ARMAZENAMENTO" Style="{StaticResource Text.Eyebrow}"/>
                        <WrapPanel>
                            <TextBlock Text="Analisar arquivos e pastas" Style="{StaticResource Text.PageTitle}" Margin="0,0,14,0"/>
                            <Border Style="{StaticResource Badge.Accent}"><TextBlock Text="DIAGNÓSTICO · somente leitura"/></Border>
                        </WrapPanel>
                    </StackPanel>

                    <Border x:Name="AnalyzeToolbar" Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,18,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Disco" Style="{StaticResource Text.MetricLabel}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Column="1" Text="Diretório para analisar" Style="{StaticResource Text.MetricLabel}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="Disks" Grid.Row="1" Margin="0,0,8,0" SelectionChanged="DiskChanged" AutomationProperties.Name="Selecionar disco"/>
                            <TextBox x:Name="RootPath" Grid.Row="1" Grid.Column="1" Margin="0,0,8,0" AutomationProperties.Name="Diretório para analisar" Tag="Caminho de um disco ou pasta"/>
                            <Button Grid.Row="1" Grid.Column="2" Click="ChooseFolder" Margin="0,0,8,0" ToolTip="Escolher uma pasta para analisar">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Text.Icon}" Margin="0,0,8,0"/><AccessText Text="Escolher _pasta…"/></StackPanel>
                            </Button>
                            <Button x:Name="AnalyzeButton" Grid.Row="1" Grid.Column="3" Style="{StaticResource Button.Primary}" Click="Analyze" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" Margin="0,0,8,0"/><AccessText Text="_Analisar"/></StackPanel>
                            </Button>
                            <Button x:Name="CancelButton" Grid.Row="1" Grid.Column="4" Click="Cancel" IsEnabled="False" ToolTip="Interrompe e preserva o resultado parcial (Esc)">
                                <AccessText Text="_Cancelar"/>
                            </Button>
                            <Grid x:Name="DiskRow" Grid.Row="2" Grid.ColumnSpan="5" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DiskSummary" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <ProgressBar x:Name="DiskBar" Grid.Column="1" Style="{StaticResource Meter}" Height="6" Maximum="100" VerticalAlignment="Center" AutomationProperties.Name="Ocupação do disco"/>
                            </Grid>
                            <TextBlock x:Name="ScanSummary" Grid.Row="3" Grid.ColumnSpan="5" Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
