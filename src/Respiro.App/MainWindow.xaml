                        </Grid>
                    </Border>

                    <TabControl x:Name="AnalyzeTabs" Grid.Row="2">
                        <TabItem Header="Arquivos e pastas">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="TreeColumn" Width="280" MinWidth="180"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*" MinWidth="300"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Padding="10,12">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top" Margin="6,0,0,10">
                                            <TextBlock Text="Pastas" Style="{StaticResource Text.CardTitle}"/>
                                            <TextBlock x:Name="TreeCaption" Text="Totais incluem subpastas: não some pais e filhos." Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                            <Button Click="AnalyzeFolder" Margin="0,0,0,6" HorizontalContentAlignment="Left" ToolTip="Nova análise restrita à pasta selecionada, para ver arquivos menores dela">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" Margin="0,0,8,0"/><TextBlock Text="Analisar esta pasta"/></StackPanel>
                                            </Button>
                                            <Button Click="ClearFolder" HorizontalContentAlignment="Left" ToolTip="Remove o filtro de pasta das listas">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Text.Icon}" Margin="0,0,8,0"/><TextBlock Text="Todas as pastas"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <Grid>
                                            <TextBlock x:Name="TreeEmpty" Style="{StaticResource Text.Caption}" Margin="6,4" Text="A árvore aparece após a análise."/>
                                            <TreeView x:Name="FolderTree" SelectedItemChanged="FolderSelected" AutomationProperties.Name="Árvore de pastas"
                                                      VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"/>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                                <GridSplitter Grid.Column="1" Width="14" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Redimensionar árvore"/>
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Click="Export" AutomationProperties.Name="Exportar relatório" ToolTip="Salvar relatório JSON ou CSV. Revise caminhos pessoais antes de compartilhar.">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEDE1;" Style="{StaticResource Text.Icon}"/><AccessText x:Name="ExportLabel" Text="_Exportar…" Margin="8,0,0,0"/></StackPanel>
                                        </Button>
                                        <WrapPanel VerticalAlignment="Center">
                                            <ComboBox x:Name="ViewFilter" Width="200" Margin="0,0,8,0" SelectionChanged="FilterChanged" AutomationProperties.Name="Tipo de resultado">
                                                <ComboBoxItem Content="Maiores arquivos"/>
                                                <ComboBoxItem Content="Possíveis regeneráveis"/>
                                                <ComboBoxItem Content="Protegidos"/>
                                                <ComboBoxItem Content="Maiores pastas"/>
                                            </ComboBox>
                                            <ComboBox x:Name="CategoryFilter" Width="220" Margin="0,0,8,0" SelectionChanged="FilterChanged" AutomationProperties.Name="Filtrar categoria"/>
                                            <ComboBox x:Name="PersonalFilter" Width="190" Margin="0,6,8,0" SelectionChanged="PersonalFilterChanged" SelectedIndex="0" AutomationProperties.Name="Encontrar arquivos pessoais">
                                                <ComboBoxItem Content="Todos os tipos"/><ComboBoxItem Content="Vídeos"/><ComboBoxItem Content="Downloads"/><ComboBoxItem Content="Instaladores / executáveis"/><ComboBoxItem Content="Compactados / imagens"/><ComboBoxItem Content="Mesmo nome e tamanho"/><ComboBoxItem Content="Sem alteração há 180 dias"/>
                                            </ComboBox>
                                            <ComboBox x:Name="PersonalMinimum" Width="130" Margin="0,6,8,0" SelectionChanged="PersonalFilterChanged" SelectedIndex="0" AutomationProperties.Name="Tamanho mínimo">
                                                <ComboBoxItem Content="Qualquer tamanho"/><ComboBoxItem Content="A partir de 100 MiB"/><ComboBoxItem Content="A partir de 1 GiB"/>
                                            </ComboBox>
                                            <Button x:Name="DuplicateCompareButton" Click="CompareDuplicateContents" Content="Comparar conteúdo da lista…" Margin="0,6,8,0" AutomationProperties.Name="Comparar possíveis duplicatas por conteúdo"/>
                                            <Button Click="PreviewPersonalFile" Content="Ver detalhes" Margin="0,6,8,0"/>
                                            <Button Click="RevealPersonalFile" Content="Localizar no Explorador" Margin="0,6,0,0"/>

                                        </WrapPanel>
                                    </DockPanel>
                                    <TextBlock Grid.Row="1" x:Name="ScopeLabel" Style="{StaticResource Text.Caption}" Margin="0,10,0,10" Text="Aguardando análise. As listas de arquivos têm limite de 1.500 registros por visão."/>
                                    <DataGrid x:Name="FilesGrid" Grid.Row="2" SelectionMode="Extended" SelectionChanged="FilesSelectionChanged" AutomationProperties.Name="Arquivos">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Tamanho lógico" Binding="{Binding Size}" SortMemberPath="Bytes" Width="112"/>
                                            <DataGridTextColumn Header="Ocupado" Binding="{Binding OccupiedText}" SortMemberPath="Occupied" Width="100"/>
                                            <DataGridTemplateColumn Header="Proteção" CellTemplate="{StaticResource ProtectionCell}" SortMemberPath="Protection" Width="210"/>
                                            <DataGridTextColumn Header="Caminho" Binding="{Binding Path}" Width="440"/>
                                            <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="190"/>
                                            <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="480"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <DataGrid x:Name="FoldersGrid" Grid.Row="2" Visibility="Collapsed" AutomationProperties.Name="Pastas">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Tamanho acumulado" Binding="{Binding Size}" SortMemberPath="Bytes" Width="150"/>
                                            <DataGridTextColumn Header="Pasta" Binding="{Binding Path}" Width="*"/>
                                            <DataGridTextColumn Header="Arquivos" Binding="{Binding Files}" Width="100"/>
                                            <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Border Grid.Row="3" Style="{StaticResource Callout}" Margin="0,12,0,0" Padding="14,8">
                                        <DockPanel>
                                            <Button x:Name="SimulateButton" DockPanel.Dock="Right" Click="Simulate" Margin="12,0,0,0" ToolTip="Abre a prévia de simulação. Nenhum arquivo é removido.">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE890;" Style="{StaticResource Text.Icon}" Margin="0,0,8,0"/><AccessText Text="_Simular seleção…"/></StackPanel>
                                            </Button>
                                            <TextBlock x:Name="SelectionSummary" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"
                                                       Text="Selecione arquivos com Ctrl ou Shift para simular. A simulação não remove nada."/>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Contexto Git">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Muted}" Margin="0,0,0,12" Text="Inventário de marcadores Git, limitado a 2.000 registros. Uma referência .git em arquivo pode ser worktree ou submódulo; não autoriza remoção. Alterações são consultadas na simulação."/>
                                <DataGrid x:Name="FindingsGrid" AutomationProperties.Name="Marcadores Git">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Caminho" Binding="{Binding Path}" Width="*"/>
                                        <DataGridTextColumn Header="Evidência" Binding="{Binding Reason}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Ocorrências e limites">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Muted}" Margin="0,0,0,12" Text="Sem privilégios de administrador. Links, junctions e placeholders não são percorridos. Os totais refletem apenas os arquivos acessíveis durante a varredura; o disco pode mudar enquanto agentes trabalham. Listas: 1.500 maiores arquivos por visão, 50.000 pastas, 1.000 ocorrências. Identidade: 500.000 arquivos; além disso, ocupação e deduplicação são inconclusivas."/>
                                <DataGrid x:Name="IssuesGrid" AutomationProperties.Name="Ocorrências">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Caminho" Binding="{Binding Path}" Width="*"/>
                                        <DataGridTextColumn Header="Ocorrência" Binding="{Binding Reason}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                    
                        <TabItem x:Name="DuplicateResultsTab" Header="Duplicatas por conteúdo">
                            <DockPanel>
                                <TextBlock x:Name="DuplicateSummary" DockPanel.Dock="Top" Style="{StaticResource Text.Body}" Margin="0,0,0,12" Text="Comparação opcional da lista exibida. Mesmo nome e tamanho indicam apenas possíveis cópias. Nenhuma cópia é removida."/>
                                <Button DockPanel.Dock="Bottom" Click="RevealDuplicateFile" Content="Localizar cópia no Explorador" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                <DataGrid x:Name="DuplicateResultsGrid" SelectionMode="Single" AutomationProperties.Name="Resultado da comparação por conteúdo">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Grupo" Binding="{Binding Group}" Width="85"/>
                                        <DataGridTextColumn Header="Resultado" Binding="{Binding State}" Width="220"/>
                                        <DataGridTextColumn Header="Tamanho" Binding="{Binding Size}" Width="110"/>
                                        <DataGridTextColumn Header="Arquivo" Binding="{Binding Path}" Width="420"/>
                                        <DataGridTextColumn Header="Detalhes" Binding="{Binding Detail}" Width="380"/>
                                        <DataGridTextColumn Header="SHA-256" Binding="{Binding SHA256}" Width="300"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
</TabControl>
                </Grid>

                <!-- ───────────── Categorias ───────────── -->
                <Grid x:Name="PageCategories" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="ARMAZENAMENTO" Style="{StaticResource Text.Eyebrow}"/>
                        <WrapPanel>
                            <TextBlock Text="Categorias e extensões" Style="{StaticResource Text.PageTitle}" Margin="0,0,14,0"/>
                            <Border Style="{StaticResource Badge.Accent}"><TextBlock Text="DIAGNÓSTICO · somente leitura"/></Border>
                        </WrapPanel>
                        <TextBlock x:Name="CategoriesSummary" Style="{StaticResource Text.Subtitle}" Text="Totais de todos os arquivos enumerados na última análise, descontando hard links reconhecidos."/>
                    </StackPanel>
                    <Border x:Name="CategoriesEmpty" Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Click="GoAnalyze" VerticalAlignment="Center" Margin="16,0,0,0" Content="Ir para Analisar"/>
                            <StackPanel>
                                <TextBlock Text="Nenhuma análise disponível" Style="{StaticResource Text.CardTitle}"/>
                                <TextBlock Text="Execute uma análise para ver quanto cada categoria e extensão ocupa." Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid x:Name="CategoriesGrid" Grid.Row="1" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="CategoriesCard" Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Por categoria" Style="{StaticResource Text.CardTitle}"/>
                                <TextBlock DockPanel.Dock="Top" Text="Barra proporcional ao tamanho lógico analisado." Style="{StaticResource Text.Caption}" Margin="0,2,0,16"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True" AutomationProperties.Name="Armazenamento por categoria">
                                    <StackPanel x:Name="CategoryChart" Margin="0,0,8,0"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border x:Name="ExtensionsCard" Grid.Column="2" Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Extensões que mais ocupam" Style="{StaticResource Text.CardTitle}"/>
                                <TextBlock DockPanel.Dock="Top" Text="Aproximadamente 2.000 extensões acompanhadas. Clique no cabeçalho para ordenar." Style="{StaticResource Text.Caption}" Margin="0,2,0,16"/>
                                <DataGrid x:Name="ExtensionsGrid" BorderThickness="0" AutomationProperties.Name="Extensões">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Extensão" Binding="{Binding Name}" Width="*" MinWidth="90"/>
                                        <DataGridTemplateColumn Header="Participação" SortMemberPath="Bytes" Width="1.3*" MinWidth="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="52"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ProgressBar Style="{StaticResource Meter}" Height="6" Maximum="100" Value="{Binding Share, Mode=OneWay}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ShareText}" TextAlignment="Right" Foreground="{DynamicResource Brush.Muted}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Tamanho" Binding="{Binding Size}" SortMemberPath="Bytes" Width="100"/>
                                        <DataGridTextColumn Header="Arquivos" Binding="{Binding CountText}" SortMemberPath="Count" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ───────────── Simulação ───────────── -->
                <Grid x:Name="PagePreview" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="ARMAZENAMENTO" Style="{StaticResource Text.Eyebrow}"/>
                        <WrapPanel>
                            <TextBlock Text="Prévia de simulação" Style="{StaticResource Text.PageTitle}" Margin="0,0,14,0"/>
                            <Border Style="{StaticResource Badge.Warning}"><TextBlock Text="SIMULAÇÃO · nenhum arquivo será removido"/></Border>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="Confere metadados, uso e contexto Git dos arquivos escolhidos em Analisar. Serve para entender riscos, não para limpar."/>
                    </StackPanel>
                    <Border x:Name="PreviewEmpty" Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Click="GoAnalyze" VerticalAlignment="Center" Margin="16,0,0,0" Content="Ir para Analisar"/>
                            <StackPanel>
                                <TextBlock Text="Nenhuma seleção simulada" Style="{StaticResource Text.CardTitle}"/>
                                <TextBlock x:Name="PreviewSummary" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" Text="Selecione arquivos nos resultados e clique em Simular seleção. Use Ctrl ou Shift para selecionar vários."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid x:Name="PreviewContent" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <UniformGrid x:Name="PreviewMetrics" Columns="3" Margin="0,0,-12,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="Arquivos simulados" Style="{StaticResource Text.MetricLabel}"/>
                                    <TextBlock x:Name="PreviewSelectedValue" Text="0" Style="{StaticResource Text.Metric}"/>
                                    <TextBlock x:Name="PreviewSelectedBytes" Style="{StaticResource Text.Caption}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="Teto lógico potencial" Style="{StaticResource Text.MetricLabel}"/>
                                    <TextBlock x:Name="PreviewPotentialValue" Text="0 B" Style="{StaticResource Text.Metric}"/>
                                    <TextBlock Text="Só possivelmente regeneráveis; não é promessa de espaço." Style="{StaticResource Text.Caption}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card.Danger}" Margin="0,0,12,12" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="Autorizado para remoção" Style="{StaticResource Text.MetricLabel}"/>
                                    <TextBlock x:Name="PreviewAuthorizedValue" Text="0 B" Style="{StaticResource Text.Metric}" Foreground="{DynamicResource Brush.Danger}"/>
                                    <TextBlock Text="A prévia geral nunca autoriza remoção." Style="{StaticResource Text.Caption}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Grid.Row="1" Style="{StaticResource Callout.Warning}" Margin="0,0,0,10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                <TextBlock x:Name="PreviewWarning" Style="{StaticResource Text.Body}" FontSize="13"
                                           Text="Política E2.5 não validada. Dependências e uso podem ser inconclusivos. A ausência de bloqueio de arquivo não prova que ele seja descartável."/>
                            </DockPanel>
                        </Border>
                        <StackPanel Grid.Row="2" Margin="0,0,0,12">
                            <TextBlock x:Name="PreviewDetail" Style="{StaticResource Text.Muted}"/>
                            <TextBlock x:Name="ProcessSummary" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <DataGrid x:Name="PreviewGrid" Grid.Row="3" AutomationProperties.Name="Resultado da simulação">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Arquivo" Binding="{Binding Path}" Width="2*" MinWidth="200"/>
                                <DataGridTextColumn Header="Tamanho" Binding="{Binding Size}" Width="100"/>
                                <DataGridTextColumn Header="Uso / integridade" Binding="{Binding Use}" Width="1.4*" MinWidth="160"/>
                                <DataGridTextColumn Header="Git" Binding="{Binding Git}" Width="1.4*" MinWidth="160"/>
                                <DataGridTemplateColumn Header="Decisão" CellTemplate="{StaticResource DecisionCell}" SortMemberPath="Decision" Width="1.6*" MinWidth="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

                <!-- ───────────── Manutenção do Windows ───────────── -->
                <Grid x:Name="PageMaintenance" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,16">
                        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="16,0,0,0">
                            <Button x:Name="WindowsDiagnoseButton" Style="{StaticResource Button.Primary}" Click="DiagnoseWindows" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" Style="{StaticResource Text.Icon}" Margin="0,0,8,0"/><AccessText Text="_Diagnosticar Windows"/></StackPanel>
                            </Button>
                            <Button Click="ExportWindows" ToolTip="Salva o diagnóstico em JSON e guarda uma cópia de trabalho comprovada em LocalAppData\Respiro\Scratch.">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEDE1;" Style="{StaticResource Text.Icon}" Margin="0,0,8,0"/><TextBlock Text="Exportar diagnóstico…"/></StackPanel>
                            </Button>
                        </WrapPanel>
                        <StackPanel>
                            <TextBlock Text="WINDOWS" Style="{StaticResource Text.Eyebrow}"/>
                            <WrapPanel>
                                <TextBlock Text="Manutenção do Windows" Style="{StaticResource Text.PageTitle}" Margin="0,0,14,0"/>
                                <Border Style="{StaticResource Badge.Accent}"><TextBlock Text="DIAGNÓSTICO · somente leitura"/></Border>
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource Callout}" Margin="0,0,0,14">
                        <TextBlock x:Name="WindowsSummary" Style="{StaticResource Text.Body}" FontSize="13" Text="Diagnóstico de armazenamento, configurações e aplicativos por consultas oficiais do Windows. Nenhuma alteração automática; acesso negado aparece como inconclusivo."/>
                    </Border>
                    <TabControl x:Name="WindowsMaintenanceTabs" Grid.Row="2">
                        


                        <TabItem Header="Medições">
                            <Grid x:Name="MaintenanceSplit">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="320"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DataGrid x:Name="WindowsDiagnosticsGrid" SelectionChanged="WindowsRowSelected" SelectionMode="Single" AutomationProperties.Name="Medições do Windows">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="270"/>
                                        <DataGridTextColumn Header="Tamanho" Binding="{Binding Size}" SortMemberPath="Bytes" Width="100"/>
                                        <DataGridTextColumn Header="Itens" Binding="{Binding CountText}" SortMemberPath="Count" Width="90"/>
                                        <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="340"/>
                                        <DataGridTextColumn Header="Localização" Binding="{Binding Location}" Width="380"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border x:Name="MaintenanceDetailCard" Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <TextBlock Text="DETALHES DA MEDIÇÃO" Style="{StaticResource Text.Eyebrow}"/>
                                            <TextBlock x:Name="DetailTitle" Style="{StaticResource Text.CardTitle}" Text="Nenhuma linha selecionada"/>
                                            <TextBlock x:Name="DetailLocation" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" Text="Selecione uma medição para ler impactos, restrições e fonte."/>
                                            <StackPanel x:Name="DetailBody" Visibility="Collapsed">
                                                <TextBlock Text="Estado" Style="{StaticResource Text.MetricLabel}" Margin="0,16,0,4"/>
                                                <TextBlock x:Name="DetailStatus" Style="{StaticResource Text.Body}" FontSize="13"/>
                                                <TextBlock Text="Impacto" Style="{StaticResource Text.MetricLabel}" Margin="0,14,0,4"/>
                                                <TextBlock x:Name="DetailImpact" Style="{StaticResource Text.Body}" FontSize="13"/>
                                                <TextBlock Text="Restrições" Style="{StaticResource Text.MetricLabel}" Margin="0,14,0,4"/>
                                                <TextBlock x:Name="DetailRestrictions" Style="{StaticResource Text.Body}" FontSize="13"/>
                                                <TextBlock Text="Fonte" Style="{StaticResource Text.MetricLabel}" Margin="0,14,0,4"/>
                                                <TextBlock x:Name="DetailSource" Style="{StaticResource Text.Muted}"/>
                                                <Border Style="{StaticResource Callout}" Margin="0,16,0,0" Padding="10,8">
                                                    <TextBlock Style="{StaticResource Text.Caption}" Text="Somente diagnóstico. O Respiro não remove esta categoria; valores podem se sobrepor e não devem ser somados."/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Recursos opcionais">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Muted}" Margin="0,0,0,12" Text="Consulta de recursos opcionais pelo provedor do Windows. Não há ativação, desativação ou recomendação automática de remoção."/>
                                <DataGrid x:Name="OptionalFeaturesGrid" AutomationProperties.Name="Recursos opcionais">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Recurso" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="150"/>
                                        <DataGridTextColumn Header="Fonte" Binding="{Binding Source}" Width="250"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Restrições e ocorrências">
                            <Border Style="{StaticResource Card}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="True">
                                    <TextBlock x:Name="WindowsNotices" Style="{StaticResource Text.Body}" FontSize="13" Text="Execute o diagnóstico para consultar restrições e eventuais falhas de acesso."/>
                                </ScrollViewer>
                            </Border>
                        </TabItem>
                                            <TabItem x:Name="OfficialToolsTab" Header="Ferramentas oficiais">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,0,0,10" Text="Selecione uma opção para revisar consequências. Valores do diagnóstico não autorizam remoção; nenhuma configuração é alterada ao selecionar."/>
                                <DataGrid x:Name="OfficialOptionsGrid" Grid.Row="1" SelectionMode="Single" SelectionChanged="OfficialOptionSelected" AutomationProperties.Name="Ferramentas oficiais de manutenção">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Manutenção" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Efeito" Binding="{Binding Effect}" Width="180"/>
                                        <DataGridTextColumn Header="Destino" Binding="{Binding Destination}" Width="180"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12">
                                    <DockPanel>
                                        <Button x:Name="OfficialOpenButton" DockPanel.Dock="Bottom" Click="OpenOfficialOption" Content="Abrir destino oficial…" IsEnabled="False" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="210">
                                            <TextBlock x:Name="OfficialOptionDetail" Style="{StaticResource Text.Body}" FontSize="12" Text="Escolha uma opção. O Respiro não executa comandos de alteração do Windows."/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="RecoveryTab" Header="Recuperação">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <Button x:Name="InvestigatePrioritiesButton" Click="InvestigatePriorities" Margin="0,0,8,6" Content="Investigar prioridades — sem limpar"/>
                                    <Button x:Name="InvestigateStorageButton" Click="InvestigateStorage" Margin="0,0,8,6" Content="Investigar C: — sem limpar"/>
                                    <Button x:Name="WindowsStorageButton" Click="OpenWindowsStorage" Margin="0,0,8,6" Content="Armazenamento do Windows…"/>
                                    <CheckBox x:Name="RecoveryPublicNpmApproval" Content="Validar tarballs npm com escopo por HTTPS anônimo" VerticalAlignment="Center" Margin="0,0,10,6" ToolTip="Opcional. Até 500 origens do registro oficial; apenas HEAD, sem credenciais, cookies ou download do conteúdo. Nada é removido."/>
                                    <CheckBox x:Name="RecoveryGrowthOrder" Content="Ordenar por crescimento" Checked="RecoveryGrowthChanged" Unchecked="RecoveryGrowthChanged" Margin="0,0,10,6" VerticalAlignment="Center"/>
                                    <Button x:Name="ExportRecoveryButton" Click="ExportRecovery" Margin="0,0,0,6" Content="Exportar oportunidades…"/>
                                </WrapPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource Callout}" Margin="0,0,0,10">
                                    <TextBlock x:Name="RecoverySummary" Style="{StaticResource Text.Body}" FontSize="13" Text="Investigação física por origem, com grupos sem sobreposição. Confirmação exige prova de origem e revalidação; nenhuma limpeza é executada nesta análise."/>
                                </Border>
                                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0" MaxHeight="170">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="RecoveryDetail" Style="{StaticResource Text.Body}" FontSize="12" Text="Selecione uma origem para ver os motivos, processos, verificações, riscos, crescimento e procedimento recomendado."/>
                                    </ScrollViewer>
                                </Border>
                                <DataGrid x:Name="RecoveryGrid" SelectionMode="Single" SelectionChanged="RecoverySelected" AutomationProperties.Name="Oportunidades de recuperação por origem">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Origem" Binding="{Binding Origin}" Width="280"/>
                                        <DataGridTextColumn Header="Físico identificado" Binding="{Binding Physical}" SortMemberPath="PhysicalBytes" Width="125"/>
                                        <DataGridTextColumn Header="Confirmado" Binding="{Binding Confirmed}" SortMemberPath="ConfirmedBytes" Width="110"/>
                                        <DataGridTextColumn Header="Pendente de revisão" Binding="{Binding Pending}" SortMemberPath="PendingReviewBytes" Width="140"/>
                                        <DataGridTextColumn Header="Protegido" Binding="{Binding Protected}" SortMemberPath="ProtectedBytes" Width="100"/>
                                        <DataGridTextColumn Header="Classificação" Binding="{Binding Classification}" Width="260"/>
                                        <DataGridTextColumn Header="Última gravação" Binding="{Binding LastActivity}" Width="140"/>
                                        <DataGridTextColumn Header="Crescimento" Binding="{Binding Growth}" Width="280"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="DevelopmentTab" Header="Avançado: desenvolvimento">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="Docker/WSL" Style="{StaticResource Text.CardTitle}"/>
                                    <WrapPanel Margin="0,8,0,8">
                                        <Button x:Name="DockerDiagnoseButton" Click="DockerDiagnose" Content="Diagnosticar Docker/WSL — sem limpar" Margin="0,0,8,6"/>
                                        <Button x:Name="DockerExportButton" Click="DockerExport" Content="Exportar diagnóstico…" Margin="0,0,8,6"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="DockerSummary" Style="{StaticResource Text.Body}" Text="Discos persistentes protegidos. Diagnóstico não inicia Docker/WSL e não autoriza remoção." Margin="0,0,0,8"/>
                                    <TextBlock x:Name="DockerAlertSummary" Style="{StaticResource Text.Caption}" Margin="0,0,0,8"/>
                                </StackPanel>
                                <TabControl x:Name="DockerTabs">
                                    <TabItem Header="Discos virtuais">
                                        <DataGrid x:Name="DockerDisksGrid" SelectionChanged="DockerDiskSelected" SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Origem" Binding="{Binding Role}" Width="110"/>
                                                <DataGridTextColumn Header="Físico ocupado" Binding="{Binding Physical}" SortMemberPath="PhysicalBytes" Width="130"/>
                                                <DataGridTextColumn Header="Lógico" Binding="{Binding Logical}" Width="110"/>
                                                <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="270"/>
                                                <DataGridTextColumn Header="Última gravação UTC" Binding="{Binding LastWriteUtc, StringFormat=dd/MM/yyyy HH:mm}" Width="160"/>
                                                <DataGridTextColumn Header="Localização" Binding="{Binding Path}" Width="600"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="Inventário Docker">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Caption}" Text="Tamanhos internos podem compartilhar camadas. Não some imagens, volumes e cache para inferir espaço no C:. Containers parados e volumes sem referência continuam protegidos." Margin="0,0,0,8"/>
                                            <DataGrid x:Name="DockerResourcesGrid" SelectionChanged="DockerResourceSelected" SelectionMode="Single">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="130"/>
                                                    <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="240"/>
                                                    <DataGridTextColumn Header="Tamanho interno" Binding="{Binding Size}" Width="140"/>
                                                    <DataGridTextColumn Header="Classificação" Binding="{Binding Classification}" Width="260"/>
                                                    <DataGridTextColumn Header="Estado" Binding="{Binding StateText}" Width="310"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </TabItem>
                                    <TabItem Header="Distribuições WSL">
                                        <DataGrid x:Name="DockerWslGrid">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Distribuição" Binding="{Binding Name}" Width="200"/>
                                                <DataGridTextColumn Header="Estado" Binding="{Binding StateText}" Width="180"/>
                                                <DataGridTextColumn Header="WSL" Binding="{Binding Version}" Width="70"/>
                                                <DataGridTextColumn Header="Local registrado (quando acessível)" Binding="{Binding BasePath}" Width="600"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="Projetos e dependências"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="DockerProjectsText" Style="{StaticResource Text.Body}"/></ScrollViewer></TabItem>
                                    <TabItem Header="Pastas e crescimento">
                                        <DataGrid x:Name="DockerFoldersGrid" SelectionChanged="DockerFolderSelected" SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Origem" Binding="{Binding Origin}" Width="260"/>
                                                <DataGridTextColumn Header="Físico" Binding="{Binding Physical}" Width="110"/>
                                                <DataGridTextColumn Header="Crescimento comparável" Binding="{Binding Growth}" Width="330"/>
                                                <DataGridTextColumn Header="Última gravação" Binding="{Binding LastActivity}" Width="160"/>
                                                <DataGridTextColumn Header="Classificação" Binding="{Binding Classification}" Width="280"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="Detalhes e restrições"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="DockerDetails" Style="{StaticResource Text.Body}"/></ScrollViewer></TabItem>
                                </TabControl>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- ───────────── Aplicativos ───────────── -->
                <ScrollViewer x:Name="PageOptimization" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="WINDOWS" Style="{StaticResource Text.Eyebrow}"/>
                        <TextBlock Text="Otimização" Style="{StaticResource Text.PageTitle}"/>
                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="Revise o que abre com o Windows e os aplicativos em execução. Inicialização, CPU, memória e espaço em disco são efeitos diferentes; nenhum ganho é prometido sem medição."/>
                        <TextBlock x:Name="OptimizationStatus" Text="Escolha uma consulta. Nenhuma alteração é aplicada automaticamente." Style="{StaticResource Text.Body}" Margin="0,12,0,12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        <TabControl x:Name="OptimizationTabs">
                            <TabItem Header="Inicialização">
                                <StackPanel Margin="12">
                                    <TextBlock Text="Entradas Run, pastas Inicializar e tarefas de logon. A presença de uma entrada não prova que o Windows a executa. Impacto de inicialização não medido." Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,12,0,12">
                                        <Button Content="Consultar inicialização" Click="RefreshOptimizationStartup" Margin="0,0,8,8"/>
                                        <Button x:Name="DisableStartupButton" Content="Desativar selecionada…" Click="DisableOptimizationStartup" IsEnabled="False" Margin="0,0,8,8"/>
                                        <Button Content="Revisar estado no Windows…" Click="OptimizationStartupSettings" Margin="0,0,8,8"/>
                                    </WrapPanel>
                                    <DataGrid x:Name="StartupGrid" Height="290" SelectionMode="Single" SelectionChanged="OptimizationSelectionChanged" AutomationProperties.Name="Entradas de inicialização">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Aplicativo" Binding="{Binding Name}" Width="170"/>
                                            <DataGridTextColumn Header="Fabricante" Binding="{Binding PublisherText}" Width="150"/>
                                            <DataGridTextColumn Header="Estado" Binding="{Binding NativeState}" Width="250"/>
                                            <DataGridTextColumn Header="Executável" Binding="{Binding TargetText}" Width="320"/>
                                            <DataGridTextColumn Header="Origem" Binding="{Binding Source}" Width="380"/>
                                            <DataGridTextColumn Header="Compatibilidade" Binding="{Binding Reason}" Width="380"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock x:Name="StartupDetail" Text="Selecione uma entrada. Atalhos, RunOnce, políticas, tarefas e entradas da máquina são somente diagnóstico. Apenas aplicativos reconhecidos e assinados podem ser alterados." Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,10,0,10"/>
                                    <TextBlock Text="Repor entrada desativada pelo Respiro" Style="{StaticResource Text.CardTitle}"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <ComboBox x:Name="StartupRestores" Width="280" DisplayMemberPath="Name" SelectionChanged="OptimizationSelectionChanged" AutomationProperties.Name="Recibos de inicialização para reposição" Margin="0,0,8,8"/>
                                        <Button x:Name="RestoreStartupButton" Content="Repor entrada selecionada…" Click="RestoreOptimizationStartup" IsEnabled="False" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                    <TextBlock Text="O recibo conserva o valor original. A reposição não sobrescreve entradas e não altera StartupApproved ou a habilitação nativa do Windows." Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Segundo plano">
                                <StackPanel Margin="12">
                                    <TextBlock Text="CPU normalizada por processadores lógicos e RAM da amostra. E/S inclui arquivos, rede e dispositivos: não é uma medição isolada do disco físico. Dados sem permissão aparecem indisponíveis ou são omitidos; a lista tem limite de 1.024 processos." Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,12,0,12">
                                        <Button Content="Medir processos" Click="RefreshOptimizationProcesses" Margin="0,0,8,8"/>
                                        <Button x:Name="CloseProcessButton" Content="Solicitar fechamento…" Click="CloseOptimizationProcess" IsEnabled="False" Margin="0,0,8,8"/>
                                    </WrapPanel>
                                    <DataGrid x:Name="ProcessGrid" Height="300" SelectionMode="Single" SelectionChanged="OptimizationSelectionChanged" AutomationProperties.Name="Amostra de processos">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Aplicativo / processo" Binding="{Binding Name}" Width="180"/>
                                            <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="70"/>
                                            <DataGridTextColumn Header="Fabricante" Binding="{Binding Publisher}" Width="180"/>
                                            <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" SortMemberPath="CpuPercent" Width="95"/>
                                            <DataGridTextColumn Header="RAM" Binding="{Binding Memory}" SortMemberPath="MemoryBytes" Width="110"/>
                                            <DataGridTextColumn Header="E/S (não só disco)" Binding="{Binding Io}" SortMemberPath="IoBytesPerSecond" Width="150"/>
                                            <DataGridTextColumn Header="Proteção" Binding="{Binding Protection}" Width="250"/>
                                            <DataGridTextColumn Header="Relacionados" Binding="{Binding Relation}" Width="310"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock x:Name="ProcessDetail" Text="Fechamento normal disponível inicialmente apenas para Spotify, VLC e Telegram com assinatura comprovada e janela na sessão atual. Windows, serviços, segurança, bancos, desenvolvimento e agentes ficam protegidos. Nenhum encerramento forçado." Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,10,0,12"/>
                                    <TextBlock Text="Permissões para trabalhar em segundo plano" Style="{StaticResource Text.CardTitle}"/>
                                    <TextBlock Text="Windows 10/11 não oferece um controle público geral para outro aplicativo alterar individualmente essas permissões. A disponibilidade varia por versão e tipo de aplicativo. Nas opções avançadas do aplicativo, revise a permissão quando o Windows a oferecer. Aplicativos desktop podem ter seus próprios controles." Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,8,0,8"/>
                                    <Button Content="Abrir aplicativos no Windows para revisar permissões…" Click="OptimizationBackgroundSettings" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Aplicativos instalados">
                                <StackPanel Margin="12">
                                    <TextBlock Text="Use o inventário existente para buscar e ordenar por tamanho, nome ou fabricante. Tamanhos informados não são espaço recuperável confirmado; último uso não está disponível." Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
                                    <Button Content="Revisar aplicativos e desinstalação individual" Click="OptimizationApps" HorizontalAlignment="Left" Margin="0,12,0,12"/>
                                    <TextBlock Text="Integração direta inicial: aplicativos de consumo reconhecidos com produto MSI inequívoco e cadastro revalidado. O Windows Installer mantém sua interface e confirmações. Outros desinstaladores, Microsoft Store, runtimes, drivers, segurança e identidades desconhecidas continuam pela interface nativa; sem remoção em lote." Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Manutenção">
                                <StackPanel Margin="12">
                                    <TextBlock Text="Recuperar espaço exige arquivos elegíveis; desativar inicialização afeta o próximo login; fechar uma janela não comprova memória recuperada. Revise as medições antes de decidir." Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
                                    <Button Content="Ver diagnóstico e recomendações de manutenção" Click="OptimizationMaintenance" HorizontalAlignment="Left" Margin="0,12,0,12"/>
                                    <TextBlock Text="Cobertura de limpeza e mecanismos oficiais" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8"/>
                                    <DataGrid x:Name="OptimizationCleanupGrid" Height="330" SelectionMode="Single" AutomationProperties.Name="Classificação dos mecanismos de limpeza">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="240"/>
                                            <DataGridTextColumn Header="Classe" Binding="{Binding Class}" Width="230"/>
                                            <DataGridTextColumn Header="Mecanismo" Binding="{Binding Mechanism}" Width="340"/>
                                            <DataGridTextColumn Header="Limites e segurança" Binding="{Binding Limit}" Width="650"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="A: limpeza direta restrita já existente. B: mecanismo oficial integrado (nenhuma nova categoria aprovada). C: interface nativa. D: bloqueada. Inicialização, fechamento e MSI não são limpeza de arquivos." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="PageApps" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="WINDOWS" Style="{StaticResource Text.Eyebrow}"/>
                        <WrapPanel>
                            <TextBlock Text="Aplicativos instalados" Style="{StaticResource Text.PageTitle}" Margin="0,0,14,0"/>
                            <Border Style="{StaticResource Badge.Accent}"><TextBlock Text="INVENTÁRIO · diagnóstico"/></Border>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="Registro de desinstalação (máquina e usuário, 32 e 64 bits) e pacotes da Microsoft Store do usuário atual. Tamanhos informados pelos instaladores podem ser incompletos; nenhum aplicativo é marcado como desnecessário. Histórico de uso não disponível; não é possível inferir quais são pouco utilizados."/>
                        <TextBlock x:Name="AppRelationship" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" Text="Data do instalador pode ser de reparo ou atualização. Mesmo fabricante não comprova dependência. Último uso indisponível."/>
                    </StackPanel>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBox x:Name="AppSearch" Width="240" MaxWidth="440" MinWidth="100" TextChanged="AppFilterChanged" Tag="Pesquisar aplicativos" AutomationProperties.Name="Filtrar aplicativos" Margin="0,0,8,8"/>
                        <ComboBox x:Name="AppTypeFilter" Width="160" SelectedIndex="0" SelectionChanged="AppTypeChanged" AutomationProperties.Name="Tipo de aplicativo" Margin="0,0,8,8">
                            <ComboBoxItem Content="Todos"/><ComboBoxItem Content="Tradicionais"/><ComboBoxItem Content="Microsoft Store"/>
                        </ComboBox>
                        <ComboBox x:Name="AppSort" Width="160" SelectedIndex="0" SelectionChanged="AppSortChanged" AutomationProperties.Name="Ordenar aplicativos" Margin="0,0,8,8">
                            <ComboBoxItem Content="Maior tamanho"/><ComboBoxItem Content="Nome"/><ComboBoxItem Content="Fabricante"/>
                        </ComboBox>
                        <Button x:Name="UninstallSelectedButton" Click="UninstallSelectedApplication" Content="Desinstalar selecionado…" IsEnabled="False" Margin="0,0,8,8"/>
                        <Button Click="OpenAppsSettings" Content="Revisar desinstalação no Windows…" Margin="0,0,8,8"/>
                        <TextBlock x:Name="AppsCount" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <Border x:Name="AppsEmpty" Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Click="DiagnoseWindows" VerticalAlignment="Center" Margin="16,0,0,0" Content="Diagnosticar Windows"/>
                            <StackPanel>
                                <TextBlock Text="Inventário ainda não carregado" Style="{StaticResource Text.CardTitle}"/>
                                <TextBlock Text="A lista é obtida junto com o diagnóstico do Windows (cerca de 30 s). Consulta somente leitura." Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DataGrid x:Name="InstalledAppsGrid" SelectionChanged="AppRelationshipSelected" Grid.Row="2" Visibility="Collapsed" AutomationProperties.Name="Aplicativos instalados">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="300"/>
                            <DataGridTextColumn Header="Fabricante" Binding="{Binding Publisher}" Width="210"/>
                            <DataGridTextColumn Header="Versão" Binding="{Binding Version}" Width="110"/>
                            <DataGridTextColumn Header="Data informada pelo instalador" Binding="{Binding InstallationDateText}" Width="195"/>
                            <DataGridTextColumn Header="Tamanho informado" Binding="{Binding Size}" SortMemberPath="Bytes" Width="140"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="160"/>
                            <DataGridTextColumn Header="Localização" Binding="{Binding Location}" Width="380"/>
                            <DataGridTextColumn Header="Observações" Binding="{Binding Notes}" Width="420"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ───────────── Limpeza ───────────── -->
                <ScrollViewer x:Name="PageCleanup" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-16,0" Padding="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="WINDOWS" Style="{StaticResource Text.Eyebrow}"/>
                        <WrapPanel>
                            <TextBlock Text="Limpeza rápida" Style="{StaticResource Text.PageTitle}" Margin="0,0,14,0"/>
                            <Border Style="{StaticResource Badge.Accent}"><TextBlock Text="REVISÃO ANTES DE LIMPAR"/></Border>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="Remoção manual, restrita e auditada. Nada é selecionado ou removido automaticamente; cada arquivo é revalidado antes da remoção."/>


                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="QuickAnalyzeButton" DockPanel.Dock="Right" Click="AnalyzeQuickCleanup" Content="1. Analisar limpeza rápida" Margin="12,0,0,0"/>
                                    <TextBlock Text="Analisar → Revisar → Selecionar → Limpar" Style="{StaticResource Text.CardTitle}"/>
                                </DockPanel>
                                <TextBlock x:Name="QuickCleanupSummary" Style="{StaticResource Text.Body}" Margin="0,10,0,10" Text="Espaço recuperável desconhecido. Analise as categorias; nenhum arquivo será selecionado automaticamente."/>
                                <DataGrid x:Name="QuickCleanupGrid" Height="230" SelectionMode="Single" SelectionChanged="QuickCategorySelected" AutomationProperties.Name="Resultados da limpeza rápida">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Categoria" Binding="{Binding Name}" Width="230"/>
                                        <DataGridTextColumn Header="Ocupado conhecido" Binding="{Binding Occupied}" Width="210"/>
                                        <DataGridTextColumn Header="Potencial estimado" Binding="{Binding Amount}" Width="270"/>
                                        <DataGridTextColumn Header="Resultado" Binding="{Binding State}" Width="260"/>
                                        <DataGridTextColumn Header="Risco" Binding="{Binding Risk}" Width="165"/>
                                        <DataGridTextColumn Header="Permissão" Binding="{Binding Permission}" Width="230"/>
                                        <DataGridTextColumn Header="Como revisar" Binding="{Binding Route}" Width="220"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="QuickCategoryDetail" Style="{StaticResource Text.Body}" Margin="0,10,0,0" Text="Escolha uma categoria para entender o que pode sair e as consequências."/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="QuickReviewButton" Click="ReviewQuickCategory" Content="2. Revisar e selecionar arquivos" IsEnabled="False" Margin="0,0,8,8"/>
                                    <Button x:Name="QuickWindowsButton" Click="QuickOpenWindows" Content="Ver orientação para revisar no Windows…" IsEnabled="False" Margin="0,0,0,8"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="As etapas de seleção, prévia e confirmação abaixo executam apenas as categorias comprovadas. Os botões de orientação não limpam nem alteram configurações."/>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="CleanupLayout" Margin="0,22,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="330"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel x:Name="CleanupFlow">
                                <Border Style="{StaticResource Callout.Accent}" Margin="0,0,0,14">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                        <TextBlock x:Name="CleanupSummary" Style="{StaticResource Text.Body}" FontSize="13"
                                                   Text="Escolha uma categoria e revise seus arquivos. Apenas formatos e origens validados podem ser autorizados. Nenhuma categoria ou arquivo é selecionado automaticamente."/>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource StepNumber}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <StackPanel>
                                            <TextBlock Text="Selecionar categoria e arquivos" Style="{StaticResource Text.CardTitle}"/>
                                            <TextBlock Text="Selecione explicitamente a categoria, liste os arquivos e escolha com Ctrl ou Shift. Categorias administrativas são identificadas e não solicitam elevação." Style="{StaticResource Text.Caption}" Margin="0,2,0,12"/>
                                            <WrapPanel Margin="0,0,0,10">
                                                <CheckBox x:Name="NpmPublicProbeApproval" Content="npm: permitir prova pública HTTPS (opcional)" Margin="0,0,10,8" Checked="NpmPublicProbeChanged" Unchecked="NpmPublicProbeChanged" ToolTip="Apenas tarballs npm com escopo. Sem credenciais, cookies ou downloads; não aprova categoria nem remoção."/>
                                                <ComboBox x:Name="WindowsCleanupCategorySelector" Width="260" Margin="0,0,10,8" SelectionChanged="WindowsCleanupCategoryChanged" AutomationProperties.Name="Categoria de limpeza — seleção explícita"/>
                                                <Button x:Name="ListOwnedButton" Click="RefreshOwnedTemporary" Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" Margin="0,0,8,0"/><TextBlock Text="Listar categoria"/></StackPanel>
                                                </Button>
                                                <TextBlock x:Name="CleanupSelectionText" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Text="Nenhum arquivo listado."/>
                                            </WrapPanel>
                                            <DataGrid x:Name="OwnedTemporaryGrid" Height="190" SelectionChanged="OwnedSelectionChanged" SelectionMode="Extended" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Arquivos da categoria selecionada">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Arquivo — seleção manual" Binding="{Binding Path}" Width="*"/>
                                                    <DataGridTextColumn Header="Tamanho" Binding="{Binding Size}" Width="100"/>
                                                    <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="1.2*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource StepNumber}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <StackPanel>
                                            <TextBlock Text="Gerar e simular a prévia" Style="{StaticResource Text.CardTitle}"/>
                                            <TextBlock Text="Verifica origem, formato, conteúdo, identidade, uso e ocupação. Mostra riscos, permissões e bloqueios. A prévia expira em cinco minutos e mudar a seleção a invalida." Style="{StaticResource Text.Caption}" Margin="0,2,0,12"/>
                                            <WrapPanel Margin="0,0,0,10">
                                                <Button x:Name="PrepareButton" Click="PrepareOwnedCleanup" Margin="0,0,10,8">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D5;" Style="{StaticResource Text.Icon}" Margin="0,0,8,0"/><TextBlock Text="Gerar prévia da seleção"/></StackPanel>
                                                </Button>
                                                <Button x:Name="SimulateCleanupButton" Click="SimulateOwnedCleanup" Margin="0,0,10,8" ToolTip="Executa todas as verificações sem remover nada.">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE890;" Style="{StaticResource Text.Icon}" Margin="0,0,8,0"/><TextBlock Text="Simular prévia"/></StackPanel>
                                                </Button>
                                                <Border Style="{StaticResource Badge.Warning}" Margin="0,0,0,8"><TextBlock Text="SIMULAÇÃO não remove"/></Border>
                                            </WrapPanel>
                                            <DataGrid x:Name="CleanupPreviewGrid" Height="170" AutomationProperties.Name="Prévia da limpeza">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Prévia / arquivo" Binding="{Binding Path}" Width="*"/>
                                                    <DataGridTextColumn Header="Tamanho" Binding="{Binding Size}" Width="100"/>
                                                    <DataGridTextColumn Header="Ocupado" Binding="{Binding OccupiedText}" Width="100"/>
                                                    <DataGridTextColumn Header="Potencial" Binding="{Binding RecoverableText}" Width="100"/>
                                                    <DataGridTextColumn Header="Origem original" Binding="{Binding OriginalPath}" Width="260"/>
                                                    <DataGridTextColumn Header="Decisão e motivo" Binding="{Binding Decision}" Width="350"/>
                                                    <DataGridTextColumn Header="Origem / evidência" Binding="{Binding Source}" Width="350"/>
                                                    <DataGridTextColumn Header="Risco" Binding="{Binding Risk}" Width="300"/>
                                                    <DataGridTextColumn Header="Permissões" Binding="{Binding Permissions}" Width="300"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource Card.Danger}" Margin="0,0,0,12">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource StepNumber}" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.DangerBorder}" TextElement.Foreground="{DynamicResource Brush.Danger}">
                                            <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="Confirmar remoção permanente" Style="{StaticResource Text.CardTitle}"/>
                                            <TextBlock Text="Aprove a categoria, digite exatamente a confirmação mostrada na prévia e confirme na caixa final. Não usa a Lixeira; não há como desfazer." Style="{StaticResource Text.Caption}" Margin="0,2,0,14"/>
                                            <CheckBox x:Name="CleanupApproval" Content="Aprovo a remoção desta categoria de temporários próprios do Respiro" Margin="0,0,0,12" Checked="CleanupInputChanged" Unchecked="CleanupInputChanged"/>
                                            <WrapPanel>
                                                <StackPanel Margin="0,0,10,8">
                                                    <TextBlock x:Name="CleanupConfirmationLabel" Text="Confirmação" Style="{StaticResource Text.MetricLabel}" Margin="0,0,0,6"/>
                                                    <TextBox x:Name="CleanupConfirmation" Width="180" AutomationProperties.Name="Confirmação de remoção" Tag="APAGAR e a quantidade"
                                                             ToolTip="Digite APAGAR e a quantidade indicada na prévia" TextChanged="CleanupConfirmationChanged"/>
                                                </StackPanel>
                                                <Button x:Name="RemoveButton" Style="{StaticResource Button.Danger}" Click="RemoveOwnedCleanup" VerticalAlignment="Bottom" Margin="0,0,0,8" IsEnabled="False">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource Text.Icon}" Margin="0,0,8,0"/><TextBlock Text="Remover após confirmação…"/></StackPanel>
                                                </Button>
                                            </WrapPanel>
                                            <TextBlock x:Name="CleanupRequirements" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource StepNumber}"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <StackPanel>
                                            <TextBlock Text="Resultado por arquivo" Style="{StaticResource Text.CardTitle}"/>
                                            <TextBlock Text="Falhas são preservadas e registradas em cleanup.jsonl ou windows-cleanup.jsonl. Bytes removidos são lógicos; o espaço livre pode variar." Style="{StaticResource Text.Caption}" Margin="0,2,0,12"/>
                                            <DataGrid x:Name="CleanupResultGrid" Height="170" AutomationProperties.Name="Resultado da limpeza">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Arquivo" Binding="{Binding Path}" Width="*"/>
                                                    <DataGridTextColumn Header="Resultado" Binding="{Binding Status}" Width="120"/>
                                                    <DataGridTextColumn Header="Detalhes" Binding="{Binding Detail}" Width="1.4*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="CleanupSide" Grid.Column="2">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="PODE SER REMOVIDO" Style="{StaticResource Text.Eyebrow}"/>
                                        <DockPanel Margin="0,4,0,0">
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Top" Margin="0,3,10,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Somente arquivos validados" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" Text="Minidumps antigos estruturais, miniaturas CMMM e itens individuais da Lixeira com origem temporária verificável. Temporários próprios continuam disponíveis."/>
                                                <TextBlock x:Name="CleanupAreaText" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="BLOQUEADO · SOMENTE DIAGNÓSTICO" Style="{StaticResource Text.Eyebrow}"/>
                                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,12" Text="Por que o Respiro não remove estas áreas:"/>
                                        <ItemsControl x:Name="BlockedReasons" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,0,0,12">
                                                        <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Top" Margin="0,3,10,0"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"/>
                                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Click="OpenWindowsStorage" HorizontalAlignment="Left" Margin="0,4,0,0" ToolTip="Abre Configurações › Sistema › Armazenamento do Windows. O Respiro não interage com essa tela.">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource Text.Icon}" Margin="0,0,8,0"/><TextBlock Text="Abrir Armazenamento do Windows"/></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ───────────── Histórico ───────────── -->
                <Grid x:Name="PageHistory" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="REGISTRO" Style="{StaticResource Text.Eyebrow}"/>
                        <WrapPanel>
                            <TextBlock Text="Histórico" Style="{StaticResource Text.PageTitle}" Margin="0,0,14,0"/>
                            <Border Style="{StaticResource Badge}"><TextBlock Text="REGISTRO LOCAL · somente leitura"/></Border>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="Eventos gravados pelo Respiro neste computador: análises, simulações, exportações e cada etapa da limpeza manual."/>
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource Callout}" Margin="0,0,0,14">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource Badge}" VerticalAlignment="Top" Margin="0,0,12,0"><TextBlock Text="Escopo parcial"/></Border>
                            <TextBlock Style="{StaticResource Text.Muted}" Text="A aba Espaço ao longo do tempo compara espaço livre e até 20 pastas observadas em análises completas do mesmo escopo. Ela não guarda o inventário completo das análises nem identifica qual programa causou o crescimento."/>
                        </DockPanel>
                    </Border>
                    <DockPanel Grid.Row="2" Margin="0,0,0,4">
                        <WrapPanel DockPanel.Dock="Right">
                            <Button Click="RefreshHistory" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" Margin="0,0,8,0"/><TextBlock Text="Atualizar"/></StackPanel>
                            </Button>
                            <Button Click="OpenDataFolder">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Text.Icon}" Margin="0,0,8,0"/><TextBlock Text="Abrir pasta de registros"/></StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock x:Name="HistorySummary" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TabControl x:Name="HistoryTabs" Grid.Row="3">
                        <TabItem Header="Operações">
                            <DataGrid x:Name="OperationsGrid" AutomationProperties.Name="Operações registradas">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data e hora" Binding="{Binding When}" SortMemberPath="At" Width="160"/>
                                    <DataGridTextColumn Header="Ação" Binding="{Binding Action}" Width="200"/>
                                    <DataGridTextColumn Header="Detalhes" Binding="{Binding Detail}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="Espaço ao longo do tempo">
                            <DockPanel>
                                <TextBlock x:Name="SpaceTimelineSummary" DockPanel.Dock="Top" Style="{StaticResource Text.Body}" Margin="0,0,0,10" Text="Amostras após análises. Espaço livre é do volume inteiro; pastas só são comparadas em análises completas do mesmo escopo. Crescimento não identifica o programa responsável. Até 128 amostras / 1 MiB, sem exclusão automática."/>
                                <DataGrid x:Name="SpaceTimelineGrid" AutomationProperties.Name="Histórico de espaço livre">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Quando" Binding="{Binding When}" Width="170"/>
                                        <DataGridTextColumn Header="Volume" Binding="{Binding Volume}" Width="85"/>
                                        <DataGridTextColumn Header="Livre no volume" Binding="{Binding Available}" Width="140"/>
                                        <DataGridTextColumn Header="Pasta analisada" Binding="{Binding Scope}" Width="*"/>
                                        <DataGridCheckBoxColumn Header="Amostra completa" Binding="{Binding Complete}" Width="140"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Limpeza manual">
                            <DataGrid x:Name="CleanupJournalGrid" AutomationProperties.Name="Registro de limpeza">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data e hora" Binding="{Binding When}" SortMemberPath="At" Width="160"/>
                                    <DataGridTextColumn Header="Etapa" Binding="{Binding Action}" Width="120"/>
                                    <DataGridTextColumn Header="Arquivo" Binding="{Binding Path}" Width="1.4*"/>
                                    <DataGridTextColumn Header="Tamanho" Binding="{Binding Size}" Width="100"/>
                                    <DataGridTextColumn Header="Detalhes" Binding="{Binding Detail}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- ───────────── Configurações ───────────── -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-16,0" Padding="0,0,16,0">
                    <StackPanel MaxWidth="980" HorizontalAlignment="Left">
                        <TextBlock Text="PREFERÊNCIAS" Style="{StaticResource Text.Eyebrow}"/>
                        <TextBlock Text="Configurações" Style="{StaticResource Text.PageTitle}"/>
                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="Aparência e informações. As regras de segurança são fixas e não podem ser alteradas pela interface."/>

                        <Border Style="{StaticResource Card}" Margin="0,22,0,12">
                            <StackPanel>
                                <TextBlock Text="Aparência" Style="{StaticResource Text.CardTitle}"/>
                                <TextBlock Text="Tema da interface. “Sistema” acompanha o modo de aplicativos do Windows." Style="{StaticResource Text.Caption}" Margin="0,2,0,14"/>
                                <StackPanel AutomationProperties.Name="Tema">
                                    <RadioButton x:Name="ThemeSystem" Style="{StaticResource Choice}" GroupName="Theme" Content="Sistema" Checked="ThemeChoice"/>
                                    <RadioButton x:Name="ThemeLight" Style="{StaticResource Choice}" GroupName="Theme" Content="Claro" Checked="ThemeChoice"/>
                                    <RadioButton x:Name="ThemeDark" Style="{StaticResource Choice}" GroupName="Theme" Content="Escuro" Checked="ThemeChoice" Margin="0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Segurança" Style="{StaticResource Text.CardTitle}"/>
                                <TextBlock Text="Comportamento fixo do aplicativo." Style="{StaticResource Text.Caption}" Margin="0,2,0,12"/>
                                <ItemsControl x:Name="SafetyRules" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock DockPanel.Dock="Left" Text="&#xEA18;" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Top" Margin="0,3,10,0"/>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" FontSize="13"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Alertas de armazenamento" Style="{StaticResource Text.CardTitle}"/>
                                <CheckBox x:Name="StorageAlertsEnabled" Content="Mostrar alertas enquanto o Respiro estiver aberto" Margin="0,10,0,10"/>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,16,10"><TextBlock Text="Mínimo livre (GiB)"/><TextBox x:Name="AlertFreeGiB" Width="140"/></StackPanel>
                                    <StackPanel Margin="0,0,16,10"><TextBlock Text="Crescimento (GiB)"/><TextBox x:Name="AlertGrowthGiB" Width="140"/></StackPanel>
                                    <StackPanel Margin="0,0,16,10"><TextBlock Text="Período (horas)"/><TextBox x:Name="AlertPeriodHours" Width="140"/></StackPanel>
                                </WrapPanel>
                                <Button x:Name="SaveStorageAlertsButton" Click="SaveStorageAlerts" Content="Salvar limites de alertas" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="StorageAlertStatus" Style="{StaticResource Text.Caption}" Margin="0,10,0,0"/>
                                <TextBlock Text="Espaço livre verificado a cada minuto com o aplicativo aberto. Crescimento avaliado após diagnósticos, usando amostras completas do mesmo escopo. Não existe serviço em segundo plano, varredura agendada nem limpeza automática." Style="{StaticResource Text.Caption}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Funcionalidades ainda não disponíveis" Style="{StaticResource Text.CardTitle}"/>
                                <TextBlock Text="Nada aqui tem botão: estas funções não existem nesta versão." Style="{StaticResource Text.Caption}" Margin="0,2,0,12"/>
                                <ItemsControl x:Name="UnavailableFeatures" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="B" Style="{StaticResource Badge}" VerticalAlignment="Top"><TextBlock Text="{Binding State}"/></Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"/>
                                                    <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Intentional}" Value="True">
                                                    <Setter TargetName="B" Property="Style" Value="{StaticResource Badge.Danger}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Limites da análise" Style="{StaticResource Text.CardTitle}"/>
                                <TextBlock x:Name="LimitsText" Style="{StaticResource Text.Muted}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Click="OpenDataFolder" VerticalAlignment="Top" Margin="16,0,0,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Text.Icon}" Margin="0,0,8,0"/><TextBlock Text="Abrir pasta"/></StackPanel>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="Dados locais" Style="{StaticResource Text.CardTitle}"/>
                                    <TextBlock x:Name="DataFolderText" Style="{StaticResource Text.Muted}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Atalhos de teclado" Style="{StaticResource Text.CardTitle}"/>
                                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,8,0,0" LineHeight="22"
                                           Text="Ctrl+1 a Ctrl+9 · ir para cada tela da barra lateral&#x0a;Esc · cancelar a operação em andamento (resultado parcial é preservado)&#x0a;Alt + letra sublinhada · acionar botões como Analisar, Cancelar e Simular&#x0a;Ctrl ou Shift + clique · selecionar vários arquivos nas listas&#x0a;Tab / Shift+Tab · mover o foco; setas navegam em listas, árvore e menu lateral"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Sobre" Style="{StaticResource Text.CardTitle}"/>
                                <TextBlock x:Name="AboutText" Style="{StaticResource Text.Muted}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Barra de status -->
            <Border Grid.Row="2" Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="32,7">
                <DockPanel>
                    <StackPanel x:Name="StatusMode" DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                        <TextBlock Text="&#xEA18;" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="{DynamicResource Brush.Accent}"/>
                        <TextBlock Text="Limpeza manual por categoria e arquivo validado" Style="{StaticResource Text.Caption}" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="Status" Text="Pronto" Style="{StaticResource Text.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

