# Publicacao por lista explicita; arquivos locais novos ficam fora por padrao.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD-PARTY-NOTICES.md
!/Directory.Build.props
!/global.json
!/NuGet.Config
!/Respiro.slnx
!/build.ps1
!/src/
!/tests/
!/docs/
/docs/*
!/docs/public/

# .NET, Visual Studio, Rider e caches.
**/bin/
**/obj/
**/.vs/
**/.idea/
**/.vscode/
**/TestResults/
**/packages/
**/node_modules/
**/*.user
**/*.suo
**/*.userosscache
**/*.sln.docstates
**/*.cache

# Publicacoes, SDKs, ferramentas e evidencias locais nunca entram no repositorio.
/artifacts/
/reports/
/tools/
/.sdk/
/.cli/
/.packages/
/backups/
/logs/
/captures/
/screenshots/
/docs/public/*.local.*
**/GuestPreparationHost.sha256
**/*.log
**/*.jsonl
**/*.bak
**/*.tmp
**/*.dmp
**/*.hiv
**/*.etl
**/*.trx
**/coverage*/

# Binarios de execucao e instalacao; fontes e icones de UI sao assets permitidos.
**/*.exe
**/*.dll
**/*.pdb
**/*.msi
**/*.msix
**/*.msixbundle
**/*.appx
**/*.nupkg
**/*.zip
**/*.7z
**/*.vhd
**/*.vhdx

# Credenciais, bancos, dados pessoais e configuracoes locais.
**/.env
**/.env.*
**/.npmrc
**/.pypirc
**/.netrc
**/NuGet.Config.user
**/*secrets*.json
**/appsettings.*.local.json
**/*.pfx
**/*.p12
**/*.pem
**/*.key
**/id_rsa*
**/id_ed25519*
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.credentials
**/*.publishsettings
**/*.pubxml.user
**/AGENTS.md
**/CLAUDE.md
